{
  "name": "fullstack-blog",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:web": "pnpm --filter @monorepo/web run dev",
    "dev:api": "pnpm --filter @monorepo/api run dev",
    "pkg:build": "pnpm --filter \"./packages/**\" run build",
    "gen:env": "tsx packages/env-schema/src/cli-entry.ts",
    "dev": "pnpm run pkg:build && pnpm --recursive --parallel run dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @monorepo/db run db:generate",
    "db:migrate": "pnpm --filter @monorepo/db run db:migrate",
    "db:push": "pnpm --filter @monorepo/db run db:push",
    "db:seed": "pnpm --filter @monorepo/db run db:seed",
    "db:studio": "pnpm --filter @monorepo/db run db:studio",
    "build": "pnpm -r run build",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "gen": "plop",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.29.1",
  "devDependencies": {
    "husky": "^9.1.7",
    "plop": "^4.0.5",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}