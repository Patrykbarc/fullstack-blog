{
	"extends": "@monorepo/tsconfig/base.json",
	"compilerOptions": {
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"declaration": true,
		"removeComments": true,
		"sourceMap": true,
		"incremental": true,
		"outDir": "./dist",
		"noImplicitAny": false,
		"strictBindCallApply": false,
		"noEmit": true,
		"types": ["jest", "node"]
	}
}
